# NewChainSafe — .env de exemplo para PoC local
# Copiar para .env e ajustar. NUNCA commitar `.env` real (ver .gitignore).
# Referência completa das opções: `.env.template` (upstream, ~32KB) e `src/config.rs`.

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_DB=vaultwarden
POSTGRES_USER=vaultwarden
POSTGRES_PASSWORD=troque-este-valor-por-um-forte
# Porta exposta no host. Trocar se 5432 já ocupada localmente (ex.: 55432).
POSTGRES_PORT=5432

# =============================================================================
# Vaultwarden — domínio e acesso
# =============================================================================
# URL pública que os clientes usam. Em PoC local: http://localhost:<port>.
DOMAIN=http://localhost:8080
VAULTWARDEN_PORT=8080

# Cadastro local desabilitado — apenas SSO Azure AD (INF-05).
SIGNUPS_ALLOWED=false

# Bloqueia convites por e-mail fora do fluxo SSO (recomendado em corporativo).
# INVITATIONS_ALLOWED=false

# Emergency Access e Sends: avaliar necessidade corporativa antes de habilitar.
# EMERGENCY_ACCESS_ALLOWED=true
# SENDS_ALLOWED=true

# =============================================================================
# Logging
# =============================================================================
# LOG_LEVEL=info
# EXTENDED_LOGGING=true

# =============================================================================
# ADMIN_TOKEN — painel /admin
# =============================================================================
# Deixar VAZIO desabilita o painel admin (padrão seguro na PoC inicial).
# Para habilitar, gerar hash Argon2id (formato preferido; plaintext gera warning):
#
#   docker compose exec vaultwarden /vaultwarden hash
#
# Cola o output entre aspas simples (compose exige escape de `$` como `$$`
# se colocar direto no compose.yaml; via .env com aspas simples é literal):
#
# ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$...$...'
#
# Alternativa (deprecated, plaintext): openssl rand -base64 48
# ADMIN_TOKEN=

# =============================================================================
# SMTP — MailDev local (dev). Em prod: SMTP corporativo.
# =============================================================================
MAILDEV_UI_PORT=1080
MAILDEV_SMTP_PORT=1025
SMTP_FROM=vaultwarden@novacorrente.local
SMTP_FROM_NAME=NewChainSafe

# =============================================================================
# SSO Azure AD (OIDC) — preenchido em INF-04 (App Registration) + INF-05
# =============================================================================
# SSO_ENABLED=true
# SSO_ONLY=false                         # NÃO ativar — BUG-01 (redirect loop com Azure AD).
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
# SSO_SCOPES=email profile
# SSO_SIGNUPS_ALLOWED=true               # provisiona conta local no 1o login SSO (recomendado)
# SSO_SIGNUPS_MATCH_EMAIL=true
# Azure AD nao envia claim `email_verified` — precisa `true` senao login SSO falha.
# SSO_ALLOW_UNKNOWN_EMAIL_VERIFICATION=true
# SIGNUPS_DOMAINS_WHITELIST=novacorrente.ind.br

# =============================================================================
# Push notifications (mobile) — opcional; requer registro no serviço Bitwarden
# =============================================================================
# PUSH_ENABLED=false
# PUSH_INSTALLATION_ID=
# PUSH_INSTALLATION_KEY=
